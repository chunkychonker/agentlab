# Generated knowledge-graph output (graphify); not part of the repo.
graphify-out/

# Untracked embedded git repo(s) created by Claude Code worktrees.
.claude/worktrees/

# Machine-local Claude Code settings. Must stay out of git AND out of the
# preflight's sight: run.sh aborts the night if `git status --porcelain` on
# main reports anything, untracked files included. scrub_artifacts already
# excludes this path from `git clean -fdx`, so it survives between runs.
.claude/settings.local.json

# Untracked strays the preflight moved out of main's way so a scratch file
# could not abort the night (see .pipeline/preflight.sh, STRAY_DIR). Contents
# are whatever was left lying in the repo — never pipeline output, so never
# committed. Safe to delete by hand once you have looked at what landed there.
.pipeline/strays/
